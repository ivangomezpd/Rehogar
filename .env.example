# Rehogar - Configuracion de entorno
# Copia este fichero a .env y rellena los valores.

# Puerto del servidor HTTP
PORT=3000

# development | production | test
NODE_ENV=development

# Secreto para firmar los tokens JWT (obligatorio en produccion)
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=genera_un_secreto_largo_aleatorio

# Ruta del fichero de base de datos SQLite
DB_PATH=./data/rehogar.db
