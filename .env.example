# Copia este archivo a .env y ajusta los valores
PORT=3000
NODE_ENV=development

# Genera un secreto largo, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obligatorio en TODOS los entornos (el servidor aborta si falta, es el valor de
# ejemplo o mide menos de 16 caracteres).
JWT_SECRET=cambia-este-secreto-por-uno-seguro

DB_PATH=./data/rehogar.db

# Origenes CORS admitidos, separados por comas. En produccion pon tu dominio
# (ej: https://rehogar.vercel.app,https://www.rehogar.es). Por defecto solo localhost.
CORS_ORIGIN=http://localhost:3000

# Pon 1 SOLO cuando el servidor este detras de un proxy que fija X-Forwarded-For
# (Nginx, Heroku, Vercel...). Sin proxy, activarlo permitiria spoofear la IP y
# saltarse los rate limits.
TRUST_PROXY=

# Datos de demo (ana@rehogar.com / carlos@rehogar.com, password123) solo se
# siembran con NODE_ENV=development Y SEED_DEMO=1. Nunca en produccion.
SEED_DEMO=

# Clave de Google Maps Embed API para el mapa de publicar casa. Genera la tuya
# en Google Cloud y restringela por referrer a tu dominio (Maps Embed API).
GOOGLE_MAPS_EMBED_KEY=
